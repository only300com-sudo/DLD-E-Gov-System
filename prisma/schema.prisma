// ============================================================
// PHASE 10 — REPORTING & ANALYTICS
// 12 dashboards + KPI dictionary + custom report builder +
// scheduled reports + export center. Read-only reporting
// queries must NOT run against the transactional DB during
// business hours — dashboards read from ReportSnapshot cache
// refreshed every 5 minutes by a scheduler.
// ============================================================

model ReportSnapshot {
  id           String   @id @default(cuid())
  snapshotType String // executive | operations | whatsapp | financial | service | audit | security | ai
  periodStart  DateTime
  periodEnd    DateTime
  data         String // JSON blob with full dashboard data
  computedAt   DateTime @default(now())
  computedBy   String // 'scheduler' | userId

  @@index([snapshotType, periodEnd])
}

model KpiDefinition {
  id                 String    @id @default(cuid())
  key                String    @unique
  name               String
  nameAr             String?
  formula            String
  numerator          String?
  denominator        String?
  dataSource         String
  ownerRole          String
  target             String?
  warningThreshold   String?
  criticalThreshold  String?
  refreshFrequency   String // real_time | hourly | daily
  exampleCalculation String?
  // Phase 12 — canonical SQL for Metabase to use (no two dashboards compute differently)
  metabaseSql        String?
  approvedAt         DateTime?
  approvedBy         String?
  changeHistory      String // JSON array
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ScheduledReport {
  id            String    @id @default(cuid())
  name          String
  reportType    String
  format        String // pdf | csv | xlsx
  schedule      String // cron-like: daily@HH:MM | weekly@DOW@HH:MM | monthly@D@HH:MM
  filters       String // JSON
  recipients    String // JSON array of emails
  isActive      Boolean   @default(true)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  lastRunStatus String?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([nextRunAt, isActive])
}

model ReportExportLog {
  id          String   @id @default(cuid())
  reportId    String   @unique
  reportType  String
  format      String
  filters     String // JSON
  rowCount    Int
  generatedBy String
  generatedAt DateTime @default(now())
  filePath    String?
  watermark   String?
  ipHash      String?

  @@index([generatedBy, generatedAt])
  @@index([reportType, generatedAt])
}

model ReportAccess {
  id         String   @id @default(cuid())
  role       String // RECEPTION_ADMIN | TRUSTEE_OFFICER | TRUSTEE_MANAGER | ADMIN
