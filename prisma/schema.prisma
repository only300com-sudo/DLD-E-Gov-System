// ============================================================
// PHASE 4 — FEE MANAGEMENT & PAYMENT TRACKING
// ============================================================
// All amounts are stored as integer fils (1 AED = 100 fils). No floats in the
// money path. DLD-side fees are flagged isDldPassthrough=true and labelled in
// the UI as "Collected by DLD — recorded here for reference only".

model FeeLine {
  id               String           @id @default(cuid())
  caseId           String
  case             Case             @relation(fields: [caseId], references: [id])
  caseNumber       String // denormalized Case.caseRef for fast queries
  clientCode       String // denormalized Client.internalId
  feeType          FeeType
  description      String
  isDldPassthrough Boolean          @default(false)
  quotedAmountFils Int // quoted amount in fils (before VAT/discount/waiver)
  vatApplicable    Boolean          @default(false)
  vatPercent       Float            @default(5.0)
  discountFils     Int              @default(0)
  waiverFils       Int              @default(0)
  waiverReason     String?
  netDueFils       Int // quoted + VAT - discount - waiver (cached, recomputed on write)
  paidFils         Int              @default(0)
  refundedFils     Int              @default(0)
  outstandingFils  Int // netDue - paid - refunded (cached)
  isMandatory      Boolean          @default(true)
  gateStage        GateStage?
  stageRecorded    String // when in the lifecycle it was created (case_open | before_delegation | ad_hoc | etc.)
  status           FeeStatus        @default(quoted)
  currency         String           @default("AED")
  createdBy        String
  createdById      String?
  createdByUser    User?            @relation("FeeLinesCreatedBy", fields: [createdById], references: [id])
  updatedById      String?
  updatedBy        User?            @relation("FeeLinesUpdatedBy", fields: [updatedById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  notes            String?
  receipts         FeeReceipt[]
  history          FeeLineHistory[]

  @@index([caseId])
  @@index([caseNumber])
  @@index([status])
  @@index([caseNumber, gateStage, isMandatory])
  @@index([isDldPassthrough])
}

// ============================================================
// PART 9.5 — FEE CATALOG (DLD + Trustee fee schedule as data)
// ============================================================
// Replaces inline fee formulas in preparation-sheet templates. Each fee
// code is a row; the calculateFees service reads from this table.
//
// Fee types:
//   - 'fixed':       fixedAmount applies
//   - 'percentage':  baseField * percentageRate, with optional percentageFloor
//   - 'tiered':      if base >= tierThreshold use tierAmountAbove else tierAmountBelow
//
// baseField values: 'saleValue' | 'propertyValue' | 'mortgageAmount' |
//                   'rentalValue' | 'amendedValueChange' | 'portfolioLoanAmount'
//
// appliesToProcedures: JSON array of procedure IDs, or ['*'] for all
// dropWhen:             JSON { field, equals } — skip this fee if context field matches
// mutualExclusionGroup: only one fee per group survives (e.g. DUBAI_MUNI_MAP vs NON_DUBAI_MAP)
// perProperty:         multiply by propertyCount (used for portfolio title deeds)
// ============================================================

model FeeCatalog {
  id                    String   @id @default(cuid())
  code                  String   @unique // e.g. DLD_REGISTRATION_SALE, TRUSTEE_FEE_SALE
  nameEn                String
  nameAr                String
  feeType               String   // 'fixed' | 'percentage' | 'tiered'
  feeCategory           String   // 'government' | 'trustee'
  isActive              Boolean  @default(true)

  // For feeType = 'fixed'
  fixedAmount           Int?     // amount in fils (1 AED = 100 fils)

  // For feeType = 'percentage'
  percentageRate        Float?   // e.g. 0.04 = 4%, 0.00125 = 0.125%
  percentageFloor       Int?     // minimum amount in fils (e.g. 200000 = AED 2,000)
  baseField             String?  // which FeeContext field to apply percentage to

  // For feeType = 'tiered'
  tierThreshold         Int?     // threshold in fils
  tierAmountAbove       Int?     // amount if base >= threshold
  tierAmountBelow       Int?     // amount if base < threshold

  // VAT
  vatApplicable         Boolean  @default(false)
  vatRate               Float    @default(0.05)

  // Application rules
  appliesToProcedures   String   // JSON array: ["SALE-001", ...] or ["*"]
  dropWhen              String?  // JSON { field, equals } — conditional skip
  mutualExclusionGroup  String?  // e.g. 'map_fee' — only one per group survives

  // Per-property multiplier (portfolio title deeds)
  perProperty           Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([feeCategory, isActive])
  @@index([isActive])
}

model FeeReceipt {
  id                   String        @id @default(cuid())
  receiptNumber        String        @unique // RCPT-YYYY-NNNNNN
  feeLineId            String
  feeLine              FeeLine       @relation(fields: [feeLineId], references: [id])
  caseId               String
  case                 Case          @relation(fields: [caseId], references: [id])
  caseNumber           String
  amountFils           Int // positive = payment, negative = refund
  paymentMethod        PaymentMethod
  paymentReference     String?
  chequeNumber         String?
  paidAt               DateTime
  collectedByUserId    String
  collectedBy          User          @relation("FeeReceiptsCollectedBy", fields: [collectedByUserId], references: [id])
  receivedConfirmedBy  String?
  attachmentDocumentId String? // links to Document.id (receipt scan/screenshot/bank slip)
  isRefund             Boolean       @default(false)
  refundOfReceiptId    String? // FK to original receipt when isRefund=true
  refundReason         String?
  status               ReceiptStatus @default(confirmed)
  verifiedBy           String?
  verifiedById         String?
  verifiedByUser       User?         @relation("FeeReceiptsVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt           DateTime?
  notes                String?
  createdBy            String
  createdById          String?
  createdByUser        User?         @relation("FeeReceiptsCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime      @default(now())

  // Phase 14 — Payment Gateway + Accountant Verification fields.
  // gatewayReferenceId holds the Stripe session id / Checkout.com pay id / POS receipt id / virtual IBAN ref.
  // settlementStatus tracks the funds' journey from initiated → confirmed_by_accounts (or bounced/refunded).
  // reconciliationFlags is a JSON snapshot of the accountant's verification checks.
  paymentMethodExtended String? // cash | credit_card_pos | payment_link | bank_transfer | virtual_iban | apple_pay | uae_pay
  gatewayReferenceId    String?
  settlementStatus      String    @default("initiated") // initiated | pending_bank_clearance | confirmed | bounced | refunded
  invoiceId             String? // link to Phase 14 Invoice (split payments: multiple receipts share invoiceId)
  invoice               Invoice?  @relation(fields: [invoiceId], references: [id])
  confirmedByAccountant String?
  confirmedAt           DateTime?
  bankClearingReference String?
  internalLedgerCode    String?
  reconciliationFlags   String? // JSON: { amountMatches: bool, sourceCleared: bool }

  @@index([feeLineId, paidAt])
  @@index([caseNumber, paidAt])
  @@index([collectedByUserId])
  @@index([invoiceId])
  @@index([gatewayReferenceId])
}

// Append-only fee-line history (mirrors document_version_history pattern).
// Every status change, payment, refund, waiver, cancellation = one row.
model FeeLineHistory {
  id          String   @id @default(cuid())
  feeLineId   String
  feeLine     FeeLine  @relation(fields: [feeLineId], references: [id])
  eventType   String // created | updated | status_changed | payment_recorded | refund_recorded | waived | cancelled | discount_applied
  oldValue    String? // JSON snapshot of relevant fields before change
