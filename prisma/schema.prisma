// ============================================================
// PHASE 5 — DLD PROCESSING RECORD (structured)
// ============================================================
// This is a *record* module, not an *integration* module. The Trustee Officer
// records what they did in the external DLD system (Dubai REST App / DLD portal).
// This platform does NOT auto-submit to DLD. Every DLD action is a manual entry
// with an audit trail.

model DldSubmission {
  id         String @id @default(cuid())
  caseId     String @unique
  case       Case   @relation(fields: [caseId], references: [id])
  caseNumber String // denormalized Case.caseRef
  clientCode String

  // Submission identity
  dldServiceName      String? // e.g. "Property Sale Registration"
  dldTransactionRef   String? // DLD's own transaction/reference number
  submissionDate      DateTime?
  processingOfficerId String? // Trustee Officer who submitted
  processingOfficer   User?     @relation("DldSubmissionsByOfficer", fields: [processingOfficerId], references: [id])
  attemptCount        Int       @default(0)

  // DLD payment (separate from Phase 4 fee ledger — this is DLD's own payment)
  dldPaymentLink      String?
  dldFeeAmountFils    Int? // DLD fee amount in fils
  dldPaymentStatus    DldPaymentStatus @default(not_required)
  dldPaymentReference String?
  dldPaymentDate      DateTime?

  // Outcome
  status                  DldStatus @default(not_submitted)
  approvalDate            DateTime?
  rejectionDate           DateTime?
  rejectionReason         String?
  additionalDocsRequested String? // JSON array of doc types
  nextRequiredAction      String?
  completionDate          DateTime?
  finalNotes              String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String
  createdById   String?
  updatedBy     String?
  updatedById   String?
  updatedByUser User?    @relation("DldSubmissionsUpdatedBy", fields: [updatedById], references: [id])

  // Timeline of status changes (immutable)
  statusHistory DldStatusHistory[]

  @@index([caseNumber])
  @@index([status])
  @@index([dldTransactionRef])
}

model DldStatusHistory {
  id              String        @id @default(cuid())
  submissionId    String
  submission      DldSubmission @relation(fields: [submissionId], references: [id])
  fromStatus      DldStatus?
  toStatus        DldStatus
  reason          String?
  changedByUserId String
  changedBy       User          @relation("DldStatusHistoryChangedBy", fields: [changedByUserId], references: [id])
