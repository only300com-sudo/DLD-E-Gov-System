// ============================================================
// PHASE 6 — AI DOCUMENT INTELLIGENCE & DATA EXTRACTION
// ============================================================
// Assistive AI: extracts, classifies, summarizes, compares, and flags.
// NEVER approves, NEVER marks legal validity, NEVER submits to DLD.
// Every AI output carries source document + confidence + model version +
// human-verification status.

model AiExtraction {
  id                 String   @id @default(cuid())
  documentRegisterId String // FK to Document.id (which version was analyzed)
  document           Document @relation(fields: [documentRegisterId], references: [id])
  documentVersion    Int
  caseId             String
  case               Case     @relation(fields: [caseId], references: [id])
  caseNumber         String
  clientCode         String

  // Run metadata
  providerKey       String // 'tesseract' | 'google_vision' | 'aws_textract' | 'azure_di' | 'stub'
  providerVersion   String
  modelVersion      String?
  templateId        String? // FK to AiExtractionTemplate
  template          AiExtractionTemplate? @relation(fields: [templateId], references: [id])
  triggeredByUserId String
  triggeredBy       User                  @relation("AiExtractionsTriggeredBy", fields: [triggeredByUserId], references: [id])
  triggeredAt       DateTime              @default(now())
  completedAt       DateTime?
  durationMs        Int?
  status            AiRunStatus           @default(queued)

  // Raw OCR output (stored as .txt sidecar file, NOT inline in DB)
  rawTextStoragePath String?
  rawTextLength      Int?
  pageCount          Int?
  detectedLanguages  String? // JSON array: ["ar","en"]

  // Classification
  classifiedDocumentType   String?
  classificationConfidence Float?
  classificationSource     String? // 'rules' | 'model' | 'manual_override'

  // Results summary
  overallConfidence        Float?
  fieldsExtractedCount     Int     @default(0)
  fieldsLowConfidenceCount Int     @default(0)
  flagsSummary             String? // JSON array of flag objects

  // Human review gate
  humanReviewStatus AiHumanReviewStatus @default(pending)
  reviewedByUserId  String?
  reviewedBy        User?               @relation("AiExtractionsReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt        DateTime?
  reviewerNotes     String?

  failureReason String?

  fields    AiExtractedField[]
  flags_rel AiFlag[]

  @@index([caseId, status])
  @@index([documentRegisterId, documentVersion])
}

model AiExtractedField {
  id           String       @id @default(cuid())
  extractionId String
  extraction   AiExtraction @relation(fields: [extractionId], references: [id])

  fieldKey          String // e.g. 'emirates_id_number'
  fieldLabelEn      String
  fieldLabelAr      String
  extractedValue    String?
  normalizedValue   String?
  dataType          String // 'text' | 'date' | 'number' | 'id' | 'phone' | 'email' | 'amount' | 'boolean' | 'long_text'
  confidence        Float // 0–1
  sourcePage        Int?
  sourceBoundingBox String?
  sourceSnippet     String?

  // Validation
  validationStatus  String? // 'ok' | 'format_invalid' | 'expired' | 'missing' | 'mismatch'
  validationMessage String?

  // Human decision
  humanDecision       FieldDecision @default(pending)
  humanCorrectedValue String?
  humanDecidedBy      String?
  humanDecidedAt      DateTime?
  humanNotes          String?

  // Mapping to internal case field + DLD field
  mapsToCaseField String?
  mapsToDldField  String?

  @@index([extractionId])
  @@index([humanDecision])
}

model AiFlag {
  id              String       @id @default(cuid())
  extractionId    String
  extraction      AiExtraction @relation(fields: [extractionId], references: [id])
  flagType        String // 'missing_page' | 'low_quality' | 'expired' | 'name_mismatch' | 'id_mismatch' | 'unit_mismatch' | 'ambiguous_authority' | 'unreadable_region' | 'translation_missing'
  severity        String // 'info' | 'warning' | 'critical'
  messageEn       String
  messageAr       String
  relatedFieldKey String?
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  resolutionNote  String?

  @@index([extractionId, severity])
}

model AiExtractionTemplate {
  id              String   @id @default(cuid())
  documentTypeKey String // matches classifiedDocumentType
  name            String
  description     String?
  fields          String // JSON: array of { fieldKey, labelEn, labelAr, dataType, required, validationRule, mapsToCaseField, mapsToDldField, confidenceThreshold }
  requiredFields  String // JSON array of fieldKeys
  crossDocChecks  String?
  defaultProvider String?
  isActive        Boolean  @default(true)
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String

  extractions AiExtraction[]

  @@unique([documentTypeKey, version])
  @@index([documentTypeKey, isActive])
}

enum AiRunStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum AiHumanReviewStatus {
  pending
  in_review
  accepted
  rejected
  partial
}

enum FieldDecision {
  pending
  accepted
  corrected
  rejected
}

