}

// ============================================================
// PHASE A — RT WORKFLOW (Confirmed State Machine)
// ============================================================
// 5 tables that encode the RT procedure workflow as data, not code.
// Both the Next.js portal and the legacy ASP.NET system read from these.
// Portal (PostgreSQL) is canonical — legacy (SQL Server) gets a read replica.
// ============================================================

// A1 — Procedure Catalog (single source of truth for all 110 procedures)
// Pilot: 13 P1 procedures. P2/P3 land in a second seed batch.
model ProcedureCatalog {
  id                String   @id  // e.g. "SALE-001"
  code              String   @unique  // e.g. "SALE_STANDARD"
  legacyObjectcode  String?  // maps to ASP.NET view name (SELL_View, etc.)
  category          String   // Sale, Grant, LeaseToOwn, Mortgage, Composite, Restriction
  nameEn            String
  nameAr            String
  priority          String   // P1 | P2 | P3
  complexity        String   // L | M | H
  workspaceStates   String   @default("[]")  // JSON array of state codes from ProcedureWorkflowState
  requiredDocs      String   @default("[]")  // JSON array of doc type keys
  feeCodes          String   @default("[]")  // JSON array of fee code keys
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([category, priority])
  @@index([isActive])

  // Back-relation from ServiceCatalogItem.procedureCatalog (Part 7 / Issue 1)
  serviceMappings    ServiceCatalogItem[]

  // Part 8B — preparation sheet templates for this procedure type
  preparationSheetTemplates  PreparationSheetTemplate[]
}

// A2 — Workflow States (the state machine as data)
// 8 states: draft, requires_modification, pending_smart_app, not_received, received, completed, cancelled, rejected
model ProcedureWorkflowState {
  id                String   @id  // ws-001 through ws-008
  stateCode         String   @unique
  stateNameEn       String
  stateNameAr       String
  workspaceSection  String   // matches ASP.NET .ascx control name
  isTerminal        Boolean  @default(false)
  allowedNext       String   @default("[]")  // JSON array of state codes
  triggerEvent      String?  // Mixpanel event key that enters this state
  icon              String?
  displayOrder      Int

  @@index([stateCode])
}

// A3 — Workflow Transitions (which button does what)
// Encodes: from_state + to_state + trigger_type + trigger_id + role + mixpanel event
model WorkflowTransition {
  id              String   @id  // t-001 through t-012
  fromState       String   // state code or "EXTERNAL" sentinel
  toState         String   // state code
  triggerType     String   // click | postback | system
  triggerId       String?  // server control id suffix (btnSend, lnkSendBack, etc.)
  mixpanelEvent   String?  // canonical event key from MixpanelEventMap
  requiresRole    String?  // officer | auditor | system | reception | null (anyone)

  @@index([fromState, toState])
}

// A4 — Mixpanel Event Map (canonical event keys ↔ transitions)
model MixpanelEventMap {
  key           String   @id  // snake_case canonical key
  displayLabel  String
  category      String   // rt_employee | auditor | lifecycle | system
  firedFrom     String   // RT | TABU | both | system
  transitions   String?  @default("[]")  // JSON array of WorkflowTransition.id
}

// A5 — Procedure Workflow History (append-only audit trail)
// One row per state transition. Written atomically with the state update.
model ProcedureWorkflowHistory {
  id              String   @id @default(cuid())
  procedureId     String   // maps to Case.id (or Case.caseRef for legacy compat)
  fromState       String
  toState         String
  transitionId    String?  // FK to WorkflowTransition.id
  actorUserId     String?  // null = system
  occurredAt     DateTime @default(now())
  reason          String?
  mixpanelEvent   String?  // resolved from WorkflowTransition → MixpanelEventMap

  @@index([procedureId, occurredAt])
}

// ============================================================
// PART 8B — DATA-FIRST PREPARATION SHEETS
// ============================================================
// Replaces the legacy PrintProcedureOutput.aspx with a data-driven template
// system. Each procedure type has one or more template versions; each case
// instantiates a sheet from the active template. When the legacy ASPX source
// is uploaded later, we add a `renderer` column to layer rendering modes
// (web | pdf | dld-xml) without changing the data model.
// ============================================================

// B1 — Preparation Sheet Template (one per procedure type + version)
model PreparationSheetTemplate {
  id                    String   @id @default(cuid())
  procedureCatalogId    String
  procedureCatalog     ProcedureCatalog @relation(fields: [procedureCatalogId], references: [id])
  version               Int      @default(1)
  isActive              Boolean  @default(true)
  // JSON schema of sections + fields. Shape documented in
  // scripts/seed-preparation-templates.ts. Sections contain fields with
  // type/required/label_en/label_ar/options/pattern/readonly/computed props.
  templateJson          String
  // Optional: render mode hint for future renderer layer
  // (web | pdf | dld-xml). Default "web" until the ASPX source is uploaded
  // and we layer rendering modes.
  renderer              String   @default("web")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  sheets                PreparationSheet[]

  @@unique([procedureCatalogId, version])
  @@index([procedureCatalogId, isActive])
}

// B2 — Preparation Sheet (one per case, filled by officer)
// When the officer opens the case's prep-sheet tab, the system loads the
// active template + any existing filled data. On submit, the filledDataJson
// is persisted and status moves draft → submitted → verified.
model PreparationSheet {
  id                    String   @id @default(cuid())
  caseId                String
  case                  Case     @relation(fields: [caseId], references: [id])
  templateId            String
  template              PreparationSheetTemplate @relation(fields: [templateId], references: [id])
  // JSON of field key → value. Matches the template's templateJson schema.
  filledDataJson        String   @default("{}")
  // draft | submitted | verified. Draft = officer is filling; submitted =
  // officer locked it for auditor review; verified = auditor signed off.
  status                String   @default("draft")
  submittedBy           String?
  submittedAt           DateTime?
  verifiedBy            String?
  verifiedAt            DateTime?
  // Optional: rejection reason if the auditor sends it back for changes
  rejectionReason       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([caseId, status])
}

// ============================================================
// PART 12 — POLICY & REGULATION KNOWLEDGE BASE
// ============================================================
// Admin uploads regulatory documents (DLD circulars, RERA decisions, trustee
// SOPs, fee schedules). The system extracts text, chunks it, (later: embeds
// it + extracts structured rules + generates advisories against live data).
//
// Human-in-the-loop: AI never applies changes directly. Every advisory
// must be approved by a named admin before it's applied.
//
// Four models:
//   KnowledgeDoc    — the uploaded document (metadata + file path + hash)
//   DocChunk        — text chunks for search/re-analysis
//   ExtractedRule   — structured rules extracted by LLM (fee rates, required
//                     docs, workflow steps, thresholds, deadlines)
//   Advisory        — diff recommendations against live data, with approve/
//                     reject/apply workflow
// ============================================================

model KnowledgeDoc {
  id              String   @id @default(cuid())
  title           String
  docType         String   // policy | circular | procedure_manual | fee_schedule | article | regulation
  issuer          String?  // DLD | RERA | Dubai Municipality | Trustee Office | Other
  language        String   @default("en")  // en | ar | bilingual
  effectiveDate   DateTime?
  // Supersession chain — when a newer doc replaces this one
  supersededAt    DateTime?
  supersededBy    String?  // FK to KnowledgeDoc.id (nullable — not a relation to avoid self-ref complexity)
  filePath        String
  fileHash        String   @unique  // SHA-256 — dedupe identical uploads
  fileSize        Int
  mimeType        String
  status          String   @default("uploaded")  // uploaded | extracting | extracted | indexed | failed
  extractionError String?
  uploadedBy      String
  uploadedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Part 12B-REG — regulation library metadata
  sourceUrl       String?   // original URL where the regulation was fetched from
  sourceType      String?   // pdf | html | pdf_disk | manual
  jurisdiction    String?   // DLD | RERA | Dubai Municipality | UAE Federal
  relatedDocId    String?   // FK to another KnowledgeDoc (cross-reference, e.g. amending law)
  libraryCategory String?   // fees | mortgage | oqood | brokerage | inheritance | general | compendium

  chunks          DocChunk[]
  extractedRules  ExtractedRule[]

  @@index([docType, status])
  @@index([issuer, effectiveDate])
  @@index([libraryCategory])
}

model DocChunk {
  id             String   @id @default(cuid())
  docId          String
  doc            KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  sequence       Int      // ordering within doc
  pageNumber     Int?
  sectionHeading String?
  text           String   // the chunk text
  tokenCount     Int
  // Embedding stored as JSON array of floats (null until embedded in Part 12B)
  embedding      String?
  createdAt      DateTime @default(now())

  @@index([docId, sequence])
  @@index([docId, pageNumber])
}

model ExtractedRule {
  id             String   @id @default(cuid())
  docId          String
  doc            KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  ruleType       String   // fee_rate | required_doc | workflow_step | threshold | deadline | procedure_def
  subjectCode    String?  // e.g. "SALE-001" or "DLD_REGISTRATION_SALE" if matched
  payload        String   // JSON — the extracted structured data
  sourceChunkIds String   // JSON array of DocChunk.id (provenance)
  confidence     Float    // 0.0 – 1.0
  createdAt      DateTime @default(now())

  @@index([docId])
  @@index([ruleType, subjectCode])
}

model Advisory {
  id             String   @id @default(cuid())
  title          String
  advisoryType   String   // fee_change | doc_change | workflow_change | procedure_gap | procedure_deprecation | threshold_change
  severity       String   // info | warning | critical
  currentState   String   // JSON — what the system currently has
  proposedState  String   // JSON — what the policy says it should be
  rationale      String   // human-readable explanation
  sourceRuleIds  String   // JSON array of ExtractedRule.id
  sourceCitations String  // JSON — [{ docId, page, snippet }]
  confidence     Float
  status         String   @default("pending")  // pending | approved | rejected | superseded
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNotes    String?
  appliedAt      DateTime?  // set when approved change is deployed
  createdAt      DateTime @default(now())

  @@index([status, severity])
  @@index([advisoryType])
}



// Part 12B — Extraction metrics (operational data for LLM extraction)
model ExtractionMetric {
  id              String   @id @default(cuid())
  docId           String
  chunkCount      Int
  rulesExtracted  Int      // before dedup
  rulesAfterDedup Int      // after dedup
  avgConfidence   Float
  durationMs      Int
  modelUsed       String
  timedOutChunks  Int
  promptVersion   String
  createdAt       DateTime @default(now())

  @@index([docId])
  @@index([createdAt])
}

// Enhancement 4 — Happiness Feedback System
model FeedbackEntry {
  id                String   @id @default(cuid())
  branchId          String?
  caseId            String?
  transactionType   String
  sourceType        String   // internal | client
  sourceUserId      String?
  sourceClientId    String?
  rating            Int      // 1-5
  category          String   // speed | clarity | accuracy | communication | overall
  comment           String?
  tags              String   @default("[]") // JSON array
  status            String   @default("new") // new | acknowledged | in_review | resolved | dismissed
  assignedToUserId  String?
  resolutionNote    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  resolvedAt        DateTime?

  @@index([branchId, status])
  @@index([sourceType, category])
  @@index([caseId])
  @@index([status, createdAt])
}

// ============================================================
// IDP FOUNDATION — Intelligent Document Processing (v0.6.0)
// Additive: 4 new models, no changes to existing models.
// Non-destructive: IDP proposes; humans approve. No auto-state-change.
// Every IDP action writes to the audit hash chain.
// ============================================================

model IdpPreprocessJob {
  id              String   @id @default(cuid())
  inputHash       String
  inputMime       String
  outputHash      String?
  outputPath      String?
  toolChain       String   // "sharp" | "libreoffice" | "ghostscript" | "pdfjs-text" | "passthrough" | "tool_missing"
  status          String   // PENDING | DONE | FAILED | TOOL_MISSING
  errorMessage    String?
  latencyMs       Int?
  createdAt       DateTime @default(now())

  @@index([inputHash])
  @@index([status])
  @@index([createdAt])
}

model IdpExtraction {
  id              String   @id @default(cuid())
  documentId      String
  preprocessJobId String
  docType         String   // emirates_id | trade_license | receipt | title_deed | contract | legal_review | shareholder_agreement | passport | noc | unknown
  schemaVersion   String
  extractedJson   String
  fieldConfidence String
  modelName       String
  modelDigest     String?
  latencyMs       Int
  overallConf    Float
  status          String   // PENDING | EXTRACTED | LOW_CONFIDENCE | FAILED
  createdAt       DateTime @default(now())

  @@index([documentId])
  @@index([status])
  @@index([docType])
}

model IdpValidationFlag {
  id               String   @id @default(cuid())
  caseId           String
  documentId       String?
  extractionId     String?
  flagType         String   // MISSING_FIELD | FORMAT_ERROR | CROSS_DOC_MISMATCH | FEE_MISMATCH | POLICY_VIOLATION | EXPIRED_DOCUMENT
  severity         String   // INFO | WARNING | BLOCKING
  details          String   // JSON
  status           String   // OPEN | RESOLVED | DISMISSED
  resolvedByUserId String?
  resolvedAt       DateTime?
  resolutionNote   String?
  createdAt        DateTime @default(now())

  @@index([caseId, status])
  @@index([severity])
  @@index([createdAt])
}

model IdpPolicyCheck {
  id              String   @id @default(cuid())
  extractionId    String
  policyVersionId String
  ruleEvaluated   String
  passed          Boolean
  evidence        String   // JSON
  createdAt       DateTime @default(now())

  @@index([extractionId])
  @@index([policyVersionId])
}
