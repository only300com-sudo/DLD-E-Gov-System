// Trustee Operations Portal — Prisma schema
// Internal Trustee Office System — Not a DLD Submission Portal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS, ROLES, BRANCHES
// ============================================================

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  nameAr             String?
  passwordHash       String
  role               UserRole
  branchId           String?
  branch             Branch?   @relation(fields: [branchId], references: [id])
  active             Boolean   @default(true)
  // Phase 7b.1 — TOTP MFA fields (replaces mfaEnabled/mfaSecret legacy fields below
  // — legacy fields kept for backward compat until 7c)
  mfaEnabled         Boolean   @default(false)
  mfaSecret          String?
  // Phase 7b.1 — Proper TOTP fields
  totpSecret         String? // base32-encoded secret
  totpEnabled        Boolean   @default(false)
  totpBackupCodes    String? // JSON array of { code, used } (each code hashed with sha256)
  totpSetupAt        DateTime?
  lastTotpAttemptAt  DateTime?
  failedTotpAttempts Int       @default(0)
  lastLoginAt        DateTime?
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  casesAsReception          Case[]                       @relation("ReceptionCases")
  casesAsOfficer            Case[]                       @relation("OfficerCases")
  casesAsManager            Case[]                       @relation("ManagerCases")
  appointments              Appointment[]
  approvals                 Approval[]
  auditLogs                 AuditLog[]
  uploadedDocuments         Document[]
  verifiedDocuments         Document[]                   @relation("VerifiedDocs")
  notificationsSent         Notification[]
  tasksAssigned             Task[]
  comments                  Comment[]
  agreementsWitness         Agreement[]                  @relation("WitnessedAgreements")
  exceptionsReviewed        ExceptionRequest[]           @relation("ExceptionReviewer")
  // Phase 3 — Handover & Return workflow back-relations
  handoversCompleted        ReceptionHandoverChecklist[]
  returnNotesIssued         ReturnNote[]                 @relation("ReturnNoteReturnedBy")
  returnNotesTargeted       ReturnNote[]                 @relation("ReturnNoteTarget")
  returnNotesResolved       ReturnNote[]                 @relation("ReturnNoteResolvedBy")
  // Phase 3.1 — DelegationEvent back-relations
  delegationEventsFrom      DelegationEvent[]            @relation("DelegationEventsFrom")
  delegationEventsTo        DelegationEvent[]            @relation("DelegationEventsTo")
  // Phase 4 — Fee ledger back-relations
  feeLinesCreatedBy         FeeLine[]                    @relation("FeeLinesCreatedBy")
  feeLinesUpdatedBy         FeeLine[]                    @relation("FeeLinesUpdatedBy")
  feeReceiptsCollectedBy    FeeReceipt[]                 @relation("FeeReceiptsCollectedBy")
  feeReceiptsVerifiedBy     FeeReceipt[]                 @relation("FeeReceiptsVerifiedBy")
  feeReceiptsCreatedBy      FeeReceipt[]                 @relation("FeeReceiptsCreatedBy")
  feeLineHistoryActor       FeeLineHistory[]             @relation("FeeLineHistoryActor")
  // Phase 5 — DLD + messages back-relations
  dldSubmissionsByOfficer   DldSubmission[]              @relation("DldSubmissionsByOfficer")
  dldSubmissionsUpdatedBy   DldSubmission[]              @relation("DldSubmissionsUpdatedBy")
  dldStatusHistoryChangedBy DldStatusHistory[]           @relation("DldStatusHistoryChangedBy")
  clientMessagesCreatedBy   ClientMessage[]              @relation("ClientMessagesCreatedBy")
  // Phase 6 — AI extractions
  aiExtractionsTriggeredBy  AiExtraction[]               @relation("AiExtractionsTriggeredBy")
  aiExtractionsReviewedBy   AiExtraction[]               @relation("AiExtractionsReviewedBy")
  // Phase 7a — Real-time collaboration
  caseEditLocksHeld         CaseEditLock[]               @relation("CaseEditLocksHeldBy")
  sessions                  Session[]
  // Phase 7b.2 — back-relations for compliance modules
  dsrAssignedTo             DataSubjectRequest[]         @relation("DsrAssignedTo")
  crossBorderRecordedBy     CrossBorderTransfer[]        @relation("CrossBorderRecordedBy")
  legalHoldSetOnCases       Case[]                       @relation("LegalHoldSetBy")
  // Phase 7c — pre-flight checklist back-relation
  preflightChecks           PreflightCheck[]             @relation("PreflightCheckedBy")
}

model Session {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  token             String   @unique
  ip                String?
  userAgent         String?
  expiresAt         DateTime
  // Phase 7b.1 — Session hardening fields
  absoluteExpiresAt DateTime // hard cap at 12h from creation, regardless of activity
  lastActivityAt    DateTime @default(now()) // updated on each authenticated request
  rotatedFrom       String? // previous session token (for rotation tracking)
  csrfToken         String? // double-submit CSRF token (one per session)
  createdAt         DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([absoluteExpiresAt])
}

model Branch {
  id           String        @id @default(cuid())
  name         String
  nameAr       String?
  address      String?
  phone        String?
  email        String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  users        User[]
  cases        Case[]
  appointments Appointment[]
}

// ============================================================
// CLIENTS, PARTIES, COMPANIES, PROPERTIES
// ============================================================

model Client {
  id                          String                @id @default(cuid())
  internalId                  String                @unique // CLIENT-YYYY-NNNNNN (kept as-is — this IS the clientCode)
  clientType                  ClientType
  capacity                    String? // buyer, seller, owner, tenant, etc.
  fullNameEn                  String
  fullNameAr                  String?
  nationality                 String?
  dateOfBirth                 String?
  emiratesId                  String?               @unique // Phase 16 — unique constraint for duplicate prevention
  passportNumber              String?               @unique // Phase 16 — unique constraint for duplicate prevention
  passportExpiry              DateTime? // Phase 16 — passport expiry tracking
  mobile                      String? // legacy phone field (kept for backward compat)
  phoneE164                   String? // Phase 16 — canonical E.164 phone (backfilled from mobile)
  email                       String?
  address                     String?
  preferredLanguage           String                @default("en")
  dataConsent                 Boolean               @default(false)
  commConsent                 Boolean               @default(false)
  // Phase 7b.2 — PDPL consent tracking
  consentPrivacyPolicyAt      DateTime?
  consentPrivacyPolicyVersion String?
  consentMarketingAt          DateTime?
  consentCommunicationsAt     DateTime?
  consentWithdrawnAt          DateTime?
  company                     Company?
  representative              ClientRepresentative?
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  // Phase 16 — lifecycle + audit
  status                      String                @default("active") // active | inactive | blacklisted | deceased
  statusChangedAt             DateTime?
  statusChangedBy             String?
  statusReason                String?
  lastActivityAt              DateTime?
  // Phase 16 — back-relations for new models
  clientAuditLog              ClientAuditLog[]
  clientDocuments             ClientDocument[]
  cases                       Case[]
  caseParties                 CaseParty[]
  documents                   Document[]
  comments                    Comment[]
  notifications               Notification[]
  agreements                  Agreement[]
  // Phase 7b.2 — back-relations
  consentRecords              ConsentRecord[]
  dataSubjectRequests         DataSubjectRequest[]

  @@index([fullNameEn])
  @@index([phoneE164])
  @@index([emiratesId])
  @@index([passportNumber])
  @@index([status])
}

// Phase 16 — Client-level audit log for every create/update/status change.
// Records old → new value, actor, reason. Immutable.
model ClientAuditLog {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  action    String // created | updated | status_changed | document_uploaded | viewed
  field     String?
  oldValue  String?
  newValue  String?
  actorId   String
  actorRole String
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([actorId, createdAt])
}

// Phase 16 — Client-scoped document vault (separate from the Case-level Document model).
// Stores identity docs (EID, passport, trade licence, POA) at the client level
// so they're reusable across multiple cases.
model ClientDocument {
  id                 String    @id @default(cuid())
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documentType       String // emirates_id | passport | trade_license | poa | other
  filePath           String
  fileName           String
  fileSize           Int
  mimeType           String
  checksum           String
  verificationStatus String    @default("pending") // pending | verified | rejected | expired
  verifiedBy         String?
  verifiedAt         DateTime?
  expiresAt          DateTime?
  uploadedBy         String
  uploadedAt         DateTime  @default(now())

  @@index([clientId, documentType])
}

model Company {
  id                  String  @id @default(cuid())
  clientId            String  @unique
  client              Client  @relation(fields: [clientId], references: [id])
  legalName           String
  licenseNumber       String?
  licenseExpiry       String?
  jurisdiction        String?
  authorizedSignatory String?
  beneficialOwner     String?
  tradeLicenseUrl     String?
}

model ClientRepresentative {
  id            String  @id @default(cuid())
  clientId      String  @unique
  client        Client  @relation(fields: [clientId], references: [id])
  repType       String // poa, board-resolution, etc.
  repName       String
  repIdNumber   String?
  poaNumber     String?
  poaIssueDate  String?
  poaExpiryDate String?
  poaScope      String?
}

model Property {
  id              String  @id @default(cuid())
  caseId          String
  case            Case    @relation(fields: [caseId], references: [id])
  propertyType    String?
  unitNumber      String?
  buildingName    String?
  project         String?
  community       String?
  area            String?
  titleDeedNumber String?
  plotNumber      String?
  ownershipType   String?
  propertyStatus  String?
}

model CaseParty {
  id       String  @id @default(cuid())
  caseId   String
  case     Case    @relation(fields: [caseId], references: [id])
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])
  role     String // buyer, seller, mortgagor, mortgagee, developer, etc.
  name     String
  idNumber String?
  contact  String?
}

// ============================================================
// SERVICE CATALOG & REQUIREMENTS
// ============================================================

model ServiceCatalogItem {
  id                      String   @id @default(cuid())
  internalCode            String   @unique
  serviceName             String
  serviceNameAr           String?
  dldCategory             String
  description             String?
  descriptionAr           String?
  applicableClientTypes   String // JSON string array
  applicablePropertyTypes String // JSON string array
  requiredParties         String // JSON string array
  mandatoryDocuments      String // JSON string array of doc-type keys
  optionalDocuments       String // JSON string array
  conditionalDocuments    String // JSON string array
  validationNotes         String?
  appointmentRequired     Boolean  @default(false)
  estimatedSlaHours       Int      @default(48)
  approvalLevel           String   @default("manager")
  feeNotes                String?
  notificationsConfig     String? // JSON
  exceptionRules          String?
  internalChecklist       String? // JSON
  // Phase 4 — auto-create fee templates. JSON array of:
  //   [{ feeType, description, defaultAmountFils, vatApplicable, isMandatory,
  //      gateStage: "before_delegation"|"before_dld_submission"|"before_completion"|null,
  //      autoCreateOnCaseOpen: boolean }]
  feeTemplates            String? // JSON
  dldReferenceLink        String?
  effectiveDate           String?
  reviewDate              String?
  version                 Int      @default(1)
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  cases                   Case[]

  // RT Workflow — Part 7 / Issue 1: explicit FK to ProcedureCatalog.
  // Replaces the brittle string-matching lookup in transition() that tried
  // ServiceCatalogItem.internalCode → ProcedureCatalog.code → legacyObjectcode.
  // Now a single indexed lookup: Case → Service → ProcedureCatalog.
  // Populated once by scripts/migrate-service-to-catalog.ts.
  // Part 7: tightened to non-nullable after the backfill script reported
  // 0 unmapped services. Future services MUST have this FK set at creation time
  // (the ServiceCatalogItem POST handler should resolve it from internalCode).
  procedureCatalogId      String
  procedureCatalog        ProcedureCatalog? @relation(fields: [procedureCatalogId], references: [id])
}

// ============================================================
// CASE / SERVICE REQUEST
// ============================================================

model Case {
  id                   String             @id @default(cuid())
  caseRef              String             @unique
  clientId             String
  client               Client             @relation(fields: [clientId], references: [id])
  serviceId            String
  service              ServiceCatalogItem @relation(fields: [serviceId], references: [id])
  branchId             String?
  branch               Branch?            @relation(fields: [branchId], references: [id])
  receptionAdminId     String?
  receptionAdmin       User?              @relation("ReceptionCases", fields: [receptionAdminId], references: [id])
  trusteeOfficerId     String?
  trusteeOfficer       User?              @relation("OfficerCases", fields: [trusteeOfficerId], references: [id])
  trusteeManagerId     String?
  trusteeManager       User?              @relation("ManagerCases", fields: [trusteeManagerId], references: [id])
  status               CaseStatus         @default(DRAFT)
  priority             Priority           @default(NORMAL)
  serviceCategory      String?
  requiresAppointment  Boolean            @default(false)
  appointmentDateTime  String?
  internalNotes        String?
  nextAction           String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  submittedAt          DateTime?
  readyForManagerAt    DateTime?
  approvedAt           DateTime?
  closedAt             DateTime?
  slaDueAt             DateTime?
  // Phase 3 — Reception Handover & Delegation Workflow
  delegationMode       String?            @default("full") // "full" (all docs collected) | "partial" (some mandatory docs missing, reception delegated anyway) | "re_delegated" (returned by officer, re-delegated by reception)
  handoverCompletedAt  DateTime? // when reception completed the handover checklist
  lastReturnReason     String? // denormalized most recent return reason for fast display in lists
  returnedAt           DateTime? // most recent time the case was returned to reception
  reDelegatedAt        DateTime? // most recent time reception re-delegated a returned case
  // Phase 7b.2 — Legal hold (excludes case from retention enforcement)
  legalHold            Boolean            @default(false)
  legalHoldReason      String?
  legalHoldSetById     String?
  legalHoldSetBy       User?              @relation("LegalHoldSetBy", fields: [legalHoldSetById], references: [id])
  legalHoldSetAt       DateTime?
  legalHoldClearedById String?
  legalHoldClearedAt   DateTime?
  archivedAt           DateTime? // set when retention job archives this case

  parties           CaseParty[]
  properties        Property[]
  documents         Document[]
  checklistItems    DocumentChecklistItem[]
  appointments      Appointment[]
  notifications     Notification[]
  tasks             Task[]
  approvals         Approval[]
  exceptions        ExceptionRequest[]
  agreements        Agreement[]
  dldRecords        DldManualRecord[]
  auditLogs         AuditLog[]
  comments          Comment[]
  statusHistory     StatusHistory[]
  handoverChecklist ReceptionHandoverChecklist?
  returnNotes       ReturnNote[]
  delegationEvents  DelegationEvent[]
  // Phase 4 — fee ledger
  fees              FeeLine[]
  feeReceipts       FeeReceipt[]
  // Phase 5 — DLD processing + client communications
  dldSubmission     DldSubmission?
  clientMessages    ClientMessage[]
  // Phase 6 — AI extractions
  aiExtractions     AiExtraction[]
  // Phase 7a — Real-time collaboration
  editLocks         CaseEditLock[]
  fieldVersions     CaseFieldVersion[]
  conflicts         FieldConflict[]
  invoices          Invoice[]
  // Phase 15.2 — Agent referral attribution. Set when a lead is converted to a case.
  referredByAgentId String?

  // Phase 17.6 — Case Preservation & Dormant Management
  // Tracks cases that have stalled for one of 7 known reasons. The scheduler
  // (17.6.2) auto-sets stallReason when conditions are met. The escalation
  // ladder (17.6.3) bumps escalationLevel as time passes.
  stallReason              String?   // client_unresponsive | documents_expired | dld_pending | other_party_unresponsive | officer_unavailable | payment_pending | legal_dispute | null
  // RT Workflow state (Phase A) — tracks the procedure's position in the state machine
  // Values: draft | pending_smart_app | requires_modification | not_received | received | completed | cancelled | rejected
  // Set by transition() in src/lib/workflow/rt/transition.ts — never set directly by other code
  // Part 7 / Issue 2: tightened to non-nullable with @default("draft") after the
  // backfill script (scripts/backfill-case-workflow-state.ts) reported 0 nulls.
  workflowState            String   @default("draft")
  stallSince               DateTime?
  stallNote                String?
  lastClientContactAt      DateTime?
  lastOfficerActionAt      DateTime?
  nextFollowUpAt           DateTime?
  escalationLevel          Int       @default(0)  // 0=none, 1=reminder, 2=manager, 3=formal
  formalAbandonmentAt      DateTime?
  formalAbandonmentReason  String?

  // Other-party contact tracking (for "other_party_unresponsive" stall reason)
  sellerLastContactAt      DateTime?
  buyerLastContactAt       DateTime?
  bankLastContactAt        DateTime?
  developerLastContactAt   DateTime?

  stallEvents              CaseStallEvent[]

  // Part 8B — preparation sheet back-relation
  preparationSheets        PreparationSheet[]
}

// Phase 17.6 — Case Preservation & Dormant Management
// Append-only audit trail of stall state transitions. Each row captures a
// transition: detected (stall first noticed), escalated (escalationLevel
// bumped), resumed (activity detected, stall cleared), or abandoned (formal
// abandonment flow completed). Used by Manager Review Queue (17.6.6) and
// Analytics KPIs (17.6.10).
model CaseStallEvent {
  id               String   @id @default(cuid())
  caseRef          String
  case             Case     @relation(fields: [caseRef], references: [caseRef], onDelete: Cascade)
  fromReason       String?  // previous stallReason (null on first detection)
  toReason         String?  // new stallReason (null on resume/abandon)
  escalationLevel  Int      // escalationLevel at time of event
  action           String   // detected | escalated | resumed | abandoned
  actorId          String?  // userId (null for system/scheduler)
  reason           String?  // free-text reason (required on abandoned)
  createdAt        DateTime @default(now())

  @@index([caseRef, createdAt])
}

// ============================================================
// PHASE 3 — RECEPTION HANDOVER CHECKLIST
// ============================================================
// Pre-delegation gate that Reception must complete before submitting a case
// to a Trustee Officer. Stored as a single row per case with a JSON-structured
// items array so it can be reconfigured without schema migrations.

model ReceptionHandoverChecklist {
  id                    String   @id @default(cuid())
  caseId                String   @unique
  case                  Case     @relation(fields: [caseId], references: [id])
  // JSON array of { key, label, labelAr, category (mandatory|optional), completed (bool), note (string), completedById, completedAt }
  items                 String   @default("[]")
  allMandatoryCompleted Boolean  @default(false)
  completedById         String?
  completedBy           User?    @relation(fields: [completedById], references: [id])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([caseId])
}

// ============================================================
// PHASE 3 — RETURN NOTE (Officer → Reception structured corrections)
// ============================================================
// When a Trustee Officer returns a case to Reception (for missing documents,
// incorrect party info, wrong service selection, etc.), they create a
// structured ReturnNote describing exactly what needs fixing. The note
// captures the missing-item keys, free-text correction instructions, and
// the target Reception admin. The case status moves to RETURNED_FOR_CORRECTION.

model ReturnNote {
  id                     String       @id @default(cuid())
  caseId                 String
  case                   Case         @relation(fields: [caseId], references: [id])
  returnedById           String
  returnedBy             User         @relation("ReturnNoteReturnedBy", fields: [returnedById], references: [id])
  targetReceptionAdminId String?
  targetReceptionAdmin   User?        @relation("ReturnNoteTarget", fields: [targetReceptionAdminId], references: [id])
  // Phase 3.1 — formal 8-status enum replaces the generic category string
  returnStatus           ReturnStatus
  reason                 String // free-text from officer
  // JSON array of missing item keys (docType keys or checklist item ids)
  missingItemKeys        String?
  // JSON array of correction instructions [{ field, problem, action }]
  correctionList         String?
  priority               String       @default("normal") // "low" | "normal" | "high" | "urgent"
  resolvedAt             DateTime? // when reception re-delegates the case
  resolvedById           String?
  resolvedBy             User?        @relation("ReturnNoteResolvedBy", fields: [resolvedById], references: [id])
  resolutionNote         String?
  createdAt              DateTime     @default(now())

  @@index([caseId])
  @@index([targetReceptionAdminId])
}

// Phase 3.1 — immutable, append-only log of every delegation / return / re-delegation
// event on a case. One row per handoff, never edited or deleted. This is the
// compliance-grade handoff audit trail that supplements the generic AuditLog
// with structured handoff-specific fields.
model DelegationEvent {
  id                  String        @id @default(cuid())
  caseId              String
  case                Case          @relation(fields: [caseId], references: [id])
  eventType           String // "delegation" | "partial_delegation" | "return" | "re_delegation"
  fromUserId          String?
  fromUser            User?         @relation("DelegationEventsFrom", fields: [fromUserId], references: [id])
  fromRole            String? // role snapshot at time of event
  toUserId            String?
  toUser              User?         @relation("DelegationEventsTo", fields: [toUserId], references: [id])
  toRole              String?
  delegatedAt         DateTime      @default(now())
  // Event-specific fields (nullable depending on eventType)
  missingDocuments    String? // JSON array of doc keys (for partial_delegation)
  returnStatus        ReturnStatus? // 8-status enum value (for return events)
  rejectedDocumentIds String? // JSON array of document ids that the officer rejected (for return events)
  changeSummary       String? // JSON for re_delegations: { newDocs, replacedDocs, statusChanges, receptionNotes, previousReturnNote }
  reason              String? // free-text reason provided with the event
  resolutionNote      String? // for re_delegations: the reception resolution note
  // Snapshot of case state at time of event (for compliance)
  caseStatusBefore    String?
  caseStatusAfter     String?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime      @default(now())

  @@index([caseId])
  @@index([eventType])
  @@index([delegatedAt])
}

enum ReturnStatus {
  returned_missing_documents
  returned_incorrect_documents
  returned_additional_information
  returned_dld_requirement
  returned_payment_required
  returned_client_attendance
  returned_manager_review
  returned_other
}

model DocumentChecklistItem {
  id                          String          @id @default(cuid())
  caseId                      String
  case                        Case            @relation(fields: [caseId], references: [id])
  docKey                      String
  docName                     String
  docNameAr                   String?
  category                    String // mandatory, optional, conditional
  status                      ChecklistStatus @default(NOT_REQUESTED)
  sortOrder                   Int             @default(0)
  reason                      String?
  comments                    String?
  conditionallyAcceptedReason String?
  updatedAt                   DateTime        @updatedAt
}

model StatusHistory {
  id            String      @id @default(cuid())
  caseId        String
  case          Case        @relation(fields: [caseId], references: [id])
  fromStatus    CaseStatus?
  toStatus      CaseStatus
  changedById   String?
  changedByName String?
  reason        String?
  createdAt     DateTime    @default(now())
}

// ============================================================
// DOCUMENTS
// ============================================================

model Document {
  id                 String                @id @default(cuid())
  // Phase 13 — caseId is now nullable so that Ejari-only documents (no regular Case
  // parent) can be stored in the same Document register table. ejariCaseId is the
  // optional FK to EjariCase — exactly one of caseId / ejariCaseId is set per row.
  caseId             String?
  case               Case?                 @relation(fields: [caseId], references: [id])
  ejariCaseId        String?
  ejariCase          EjariCase?            @relation(fields: [ejariCaseId], references: [id])
  clientId           String?
  client             Client?               @relation(fields: [clientId], references: [id])
  partyId            String?
  docType            String
  docName            String
  fileName           String
  filePath           String
  fileSize           Int
  mimeType           String
  classification     String                @default("Confidential")
  issueDate          String?
  expiryDate         String?
  version            Int                   @default(1)
  isCurrentVersion   Boolean               @default(true)
  previousVersionId  String?
  uploadedById       String?
  uploadedBy         User?                 @relation(fields: [uploadedById], references: [id])
  verifiedById       String?
  verifiedBy         User?                 @relation("VerifiedDocs", fields: [verifiedById], references: [id])
  verificationStatus DocVerificationStatus @default(PENDING)
  verificationDate   DateTime?
  comments           String?
  watermark          Boolean               @default(true)
  // Phase 2 — Document Register fields
  clientCode         String? // denormalized Client.internalId for fast path building
  caseNumber         String? // denormalized Case.caseRef
  serviceType        String? // denormalized Service.internalCode
  documentCategory   String? // Identity / Property / POA / Payment / DLD_Submission / DLD_Approved / Agreements / Communications / Internal
  checklistItemId    String? // links to DocumentChecklistItem.id
  partyName          String?
  partyRole          String? // Seller / Buyer / Heir / Representative etc.
  replacementReason  String? // required when version > 1
  checksum           String? // SHA-256 file integrity hash
  aiExtractionId     String? // links to AI extraction record (Phase 6)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  versionHistory DocumentVersionHistory[]
  // Phase 6 — AI extractions
  aiExtractions  AiExtraction[]
}

// Immutable log of every version of every document. Append-only — never updated or deleted.
model DocumentVersionHistory {
  id                 String   @id @default(cuid())
  documentRegisterId String // references Document.id (the latest version)
  document           Document @relation(fields: [documentRegisterId], references: [id])
  version            Int // version number captured at this history row
  fileName           String
  filePath           String
  fileSize           Int?
  mimeType           String?
  checksum           String?
  uploadedById       String?
  uploadedAt         DateTime
  replacedByVersion  Int? // which version superseded this one (null if current)
  replacementReason  String? // reason provided when this version was replaced
